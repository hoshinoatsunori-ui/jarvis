# Jarvis が読む環境変数。このファイルを `.env` という名前でコピーして値を書くと、
# 起動時に自動で読み込まれる（.env は .gitignore 済み。コミットされない）。
#
#   Windows  : copy .env.example .env
#   mac/Linux: cp .env.example .env
#
# 既に環境変数が設定されていれば、そちらが優先される。
# 読み込まれたかは `jarvis -v doctor` で確認できる。

# LLM（既定の engine: anthropic）
# キーは https://console.anthropic.com/settings/keys で発行する。
# `ant auth login` でプロファイルを作ってある場合は未設定でよい。
ANTHROPIC_API_KEY=

# クラウド STT / TTS にフォールバックする場合のみ
OPENAI_API_KEY=

# ウェイクワードに Porcupine を使う場合のみ（Picovoice Console で発行）
PICOVOICE_ACCESS_KEY=

# S2S 寄り道 PoC (experiments/s2s/gemini_live.py) に使う。
# キーは https://aistudio.google.com/apikey で発行する。
GEMINI_API_KEY=
